{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huijian",
  "compatibility_date": "2026-10-21",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  }
}
