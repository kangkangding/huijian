{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huijian",
  "compatibility_date": "2026-10-21",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "oranook.com", "custom_domain": true },
    { "pattern": "www.oranook.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  }
}
